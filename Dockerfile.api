FROM node:20-bullseye

# Detect target arch at build time (amd64/arm64, etc.)
ARG TARGETARCH

# Install Google Chrome for Puppeteer (system Chrome)
RUN set -eux; \
  apt-get update; \
  apt-get install -y wget gnupg ca-certificates fonts-liberation curl; \
  if [ "${TARGETARCH:-amd64}" = "amd64" ]; then \
    wget -qO- https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor >/usr/share/keyrings/google.gpg; \
    echo "deb [signed-by=/usr/share/keyrings/google.gpg arch=amd64] http://dl.google.com/linux/chrome/deb/ stable main" >/etc/apt/sources.list.d/google-chrome.list; \
    apt-get update && apt-get install -y google-chrome-stable; \
  else \
    apt-get update && apt-get install -y chromium; \
    if [ -x /usr/bin/chromium-browser ]; then ln -sf /usr/bin/chromium-browser /usr/bin/google-chrome-stable; else ln -sf /usr/bin/chromium /usr/bin/google-chrome-stable; fi; \
  fi; \
  rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install production deps first
COPY package*.json ./
RUN npm ci --omit=dev

# Copy source
COPY . .

# Puppeteer should use system Chrome inside the container
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable \
    NODE_ENV=production \
    PORT=3000

# NOTE (Sept 2026): deliberately NOT using a Docker VOLUME instruction here.
# Railway's build validator rejects it outright (confirmed via Railway's own
# "Diagnose" feature on a real failed deploy) — Railway has its own separate
# persistent-volume system instead, configured in its dashboard (already
# attached to this service as "api-volume"). Persistence for /app/data,
# /app/session, and /app/MonitoringData depends on that Railway volume being
# mounted at (or covering) those paths — verify the mount path in Railway's
# dashboard matches, don't just rely on this file.

# Expose API port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

# Default entrypoint runs the API server
ENTRYPOINT ["node", "api.js"]

